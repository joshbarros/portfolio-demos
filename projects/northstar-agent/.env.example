# Copy to .env and adjust. Never commit the real file.
POSTGRES_PASSWORD=change-me-in-production
APP_PORT=8093

# Optional: enables the protected /api/admin/ingest endpoint.
ADMIN_TOKEN=
# Optional: a real LLM answer path. Without it the agent uses the deterministic
# extractive mode, which is reported in every response as mode="deterministic".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NORTHSTAR_MODE=demo
